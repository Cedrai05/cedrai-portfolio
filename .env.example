# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.

# --- 관리자 로그인 ---
ADMIN_ID=
ADMIN_PASSWORD=
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- seKUrity 자료 열람 계정 (다운로드 전용) ---
CLUB_ID=seKUrity
CLUB_PASSWORD=

# --- 프로젝트 편집 → GitHub 커밋 ---
# github.com/settings/personal-access-tokens 에서 이 레포에만 Contents: Read and write 권한을 준 토큰
GITHUB_TOKEN=
GITHUB_REPO=Cedrai05/cedrai-portfolio
GITHUB_BRANCH=main
GITHUB_FILE_PATH=data/projects.json

# --- Go 파일 공유 (Vercel Function + 암호화된 GitHub 데이터 브랜치) ---
# 기존 관리자 계정, 세션 비밀키, GITHUB_TOKEN, GITHUB_REPO를 재사용합니다.
FILE_SHARE_BRANCH=file-share-data
FILE_SHARE_PUBLIC_BASE_URL=https://www.cedrai.info
# Vercel Cron 인증용 무작위 32자 이상 비밀값
CRON_SECRET=
# 로컬 디스크 실습에서는 FILE_SHARE_STORAGE=local 및 FILE_SHARE_DATA_DIR을 별도로 지정합니다.

# --- 외부 파일 업로드 (Vercel Blob Private Store) ---
# Vercel 프로젝트 Storage에서 Private Blob을 생성하면 자동으로 발급됩니다.
BLOB_READ_WRITE_TOKEN=
# Vercel 프로젝트에 Blob Store를 연결하면 자동으로 설정될 수 있습니다.
BLOB_STORE_ID=
